# Application Environment
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
PROJECT_NAME="FUNDAMICS LMS API"

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Supabase PostgreSQL Database (Connection Pooler URL)
DATABASE_URL=postgresql+asyncpg://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SYNC_DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# JWT Security
JWT_SECRET_KEY=generate_a_secure_random_64_character_hex_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
TIMEZONE=Asia/Kolkata

# Storage Configuration (local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage/notes

# Biometric API Integration
SECUREYE_DEVICE_SECRET=change_this_to_a_secure_shared_device_secret
ERP_API_KEY=your_erp_api_key

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,https://fundamicstutorials.in

# Hostinger SMTP Configuration
# NOTE: Cloud hosting platforms (Render, etc.) block port 465. Always use port 587 with STARTTLS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=info@fundemicstutorials.in
SMTP_PASSWORD=your_hostinger_mailbox_password
MAIL_FROM=info@fundemicstutorials.in
MAIL_FROM_NAME="FUNDAMICS TUTORIALS"
NOTIFICATIONS_ENABLED=true

# Frontend Portal URL (used for password reset and verification links)
FRONTEND_BASE_URL=http://localhost:3000
