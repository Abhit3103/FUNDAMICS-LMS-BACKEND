# Application Configuration
APP_ENV=production
DEBUG=true
API_V1_PREFIX=/api/v1
PROJECT_NAME="FUNDAMICS LMS API"

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Database Connection (PostgreSQL / Supabase asyncpg & sync)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:5432/<database>
SYNC_DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
TIMEZONE=Asia/Kolkata

# Storage Configuration (local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage/notes

# Biometric & Hardware API Secret
SECUREYE_DEVICE_SECRET=change_this_to_a_secure_shared_device_secret

# Notifications & Integrations
NOTIFICATIONS_ENABLED=true
ERP_API_KEY=test_erp_key

# CORS Whitelist (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
