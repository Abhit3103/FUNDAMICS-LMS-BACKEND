# ==============================================================================
# FUNDAMICS LMS BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Duplicate this file as '.env' and substitute with your local or production secrets.
# NEVER commit sensitive credentials or live secrets into version control.
# ==============================================================================

# Application Runtime Configuration
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
PROJECT_NAME="FUNDAMICS LMS API"
VERSION=1.4.0
HOST=0.0.0.0
PORT=8000
TIMEZONE=Asia/Kolkata

# Primary Database Connection (PostgreSQL 16)
# Async URI for application runtime (asyncpg)
DATABASE_URL=postgresql+asyncpg://fundamics_app:fundamics_secure_pass@localhost:5432/fundamics_lms
# Sync URI for synchronous tools / fallback (psycopg2)
SYNC_DATABASE_URL=postgresql://fundamics_app:fundamics_secure_pass@localhost:5432/fundamics_lms

# Optional Supabase Integration
SUPABASE_URL=
SUPABASE_KEY=

# Security & Authentication (JWT HS256)
# Minimum 32-character high-entropy secret string
JWT_SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage Configuration
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage/notes

# Biometric Device Integration (Secureye Webhook Secret)
SECUREYE_DEVICE_SECRET=change_this_to_a_secure_shared_device_secret

# External Services & Notifications
NOTIFICATIONS_ENABLED=true
ERP_API_KEY=test_erp_key

# Cross-Origin Resource Sharing (CORS)
# Local development frontend origins:
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Production/Preview frontend origins (supplied via environment variable in deployment):
# PRODUCTION_CORS_ORIGINS=https://fundamics-frontend.onrender.com

# Migration & Testing Database Overrides (Optional)
# ALEMBIC_DATABASE_URL=postgresql+asyncpg://fundamics_app:fundamics_secure_pass@localhost:5432/fundamics_lms
# TEST_DATABASE_URL=postgresql+asyncpg://fundamics_app:fundamics_secure_pass@localhost:5433/fundamics_test
