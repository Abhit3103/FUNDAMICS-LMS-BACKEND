# FUNDAMICS Coaching Centre LMS Backend Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# Application
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
PROJECT_NAME="FUNDAMICS LMS API"

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Supabase API Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-publishable-or-anon-key

# Database Connection (PostgreSQL)
# Async format (Application runtime):
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-db-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
# Sync format (Alembic fallback):
SYNC_DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Security & Cryptography (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Institute Timezone
TIMEZONE=Asia/Kolkata

# Storage Configuration (local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage/notes

# Biometric Secureye Adapter Secret
SECUREYE_DEVICE_SECRET=change_this_to_a_secure_shared_device_secret

# External Notification & ERP Stub Settings
NOTIFICATIONS_ENABLED=true
ERP_API_KEY=test_erp_key

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
